[worldserver]

###################################################################################################
# Автоматическое изучение заклинаний
###################################################################################################

# Включить или отключить модуль.
# 0 = отключен
# 1 = включен
# По умолчанию: 1
AutoLearnSpells.Enable = 1

# При входе персонажа в игру проверить и восстановить все
# отсутствующие классовые заклинания из списка модуля.
# Полезно после обновления модуля или исправления данных.
#
# 0 = не проверять
# 1 = проверять
# По умолчанию: 1
AutoLearnSpells.CheckOnLogin = 1

# При понижении уровня удалить классовые заклинания и ранги,
# требующие более высокий уровень. После удаления модуль
# восстанавливает максимальные ранги, доступные на текущем уровне.
# Проверка также выполняется при входе, если CheckOnLogin = 1.
# Удаляются только заклинания, перечисленные в таблице этого модуля.
# Таланты, расовые и посторонние заклинания не затрагиваются.
#
# 0 = не удалять заклинания при понижении уровня
# 1 = синхронизировать заклинания с текущим уровнем
# По умолчанию: 1
AutoLearnSpells.RemoveAboveLevel = 1

# Не изучать новый ранг заклинания, если персонаж
# не знает предыдущий ранг.
# Позволяет сохранить правильную последовательность
# изучения способностей.
#
# 0 = игнорировать отсутствие предыдущего ранга
# 1 = требовать предыдущий ранг
# По умолчанию: 1
AutoLearnSpells.RequirePreviousRank = 1

# Максимальный уровень персонажа, до которого модуль
# автоматически изучает заклинания.
#
# По умолчанию: 80
AutoLearnSpells.MaxLevel = 80
