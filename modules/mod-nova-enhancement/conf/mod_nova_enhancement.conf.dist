[worldserver]

# Enable the Nova character enhancement system.
NovaEnhancement.Enable = 1

# Achievement points required for one enhancement point.
NovaEnhancement.AchievementPointsPerPoint = 4

# Permit players to reset all allocated enhancement points.
NovaEnhancement.AllowReset = 1

# Maximum points in one statistic. 0 means unlimited.
NovaEnhancement.MaxPointsPerStat = 0
